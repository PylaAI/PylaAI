# --- Discord application (Developer Portal > your app) ---
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=replace-me
DISCORD_BOT_TOKEN=replace-me

# --- Your guild and the role(s) that unlock PylaAI ---
DISCORD_GUILD_ID=000000000000000000
# Comma-separated: any one of these roles grants access.
DISCORD_ROLE_IDS=000000000000000000

# --- This service ---
# Public HTTPS origin, must match the redirect URI registered on Discord.
PYLA_PUBLIC_URL=https://auth.example.com
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PYLA_TOKEN_SECRET=replace-me-with-at-least-32-characters

# --- Optional tuning ---
# How long a client token stays valid before a fresh sign-in (seconds).
PYLA_TOKEN_TTL=86400
# How long a role lookup is cached; also the worst-case revocation delay (seconds).
PYLA_ROLE_CACHE_TTL=60
# How long an in-flight login may take before its state expires (seconds).
PYLA_STATE_TTL=600
